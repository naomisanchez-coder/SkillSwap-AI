NODE_ENV=development
HOST=127.0.0.1
PORT=4000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=skillswap_app
DB_PASSWORD=
DB_NAME=skillswap_ai
CORS_ORIGIN=http://localhost:5173

# Activar solo con un proveedor y remitente reales autorizados.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Política OTP aprobada; el servidor rechaza valores distintos.
OTP_HMAC_KEY_HEX=
OTP_HMAC_KEY_VERSION=
OTP_DIGITS=6
OTP_TTL_SECONDS=600
OTP_COOLDOWN_SECONDS=60
OTP_WINDOW_SECONDS=3600
OTP_MAX_PER_WINDOW=5
OTP_MAX_ATTEMPTS=5

# Clave exclusiva de 32 bytes, estable a través de reinicios; nunca reutilizar la clave OTP.
OTP_RATE_HMAC_KEY_HEX=

# Login: clave HMAC independiente y estable. No confiar en proxies por defecto.
LOGIN_RATE_HMAC_KEY_HEX=
TRUST_PROXY_HOPS=0
# Clave independiente para derivar CSRF ligado a cada sesión.
SESSION_CSRF_KEY_HEX=

# Recuperación 1.5B: claves independientes entre sí y de OTP/login. No habilitar antes de aplicar 004.
PASSWORD_RECOVERY_HMAC_KEY_HEX=
PASSWORD_RECOVERY_HMAC_KEY_VERSION=v1
PASSWORD_RECOVERY_RATE_HMAC_KEY_HEX=
