NODE_ENV=development
HOST=127.0.0.1
PORT=4000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=skillswap_app
DB_PASSWORD=
DB_NAME=skillswap_ai
# Parejas locales admitidas: skillswap_ai/skillswap_app,
# skillswap_ai_test_auth/skillswap_test_app o skillswap_ai_demo/skillswap_demo_app.
PRIVATE_STORAGE_ROOT=
CORS_ORIGIN=http://localhost:5173

# Activar solo con un proveedor y remitente reales autorizados.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Política OTP aprobada; el servidor rechaza valores distintos.
OTP_HMAC_KEY_HEX=
OTP_HMAC_KEY_VERSION=
OTP_DIGITS=6
OTP_TTL_SECONDS=600
OTP_COOLDOWN_SECONDS=60
OTP_WINDOW_SECONDS=3600
OTP_MAX_PER_WINDOW=5
OTP_MAX_ATTEMPTS=5

# Clave exclusiva de 32 bytes, estable a través de reinicios; nunca reutilizar la clave OTP.
OTP_RATE_HMAC_KEY_HEX=

# Login: clave HMAC independiente y estable. No confiar en proxies por defecto.
LOGIN_RATE_HMAC_KEY_HEX=
TRUST_PROXY_HOPS=0
# Clave independiente para derivar CSRF ligado a cada sesión.
SESSION_CSRF_KEY_HEX=

# Recuperación 1.5B: claves independientes entre sí y de OTP/login. No habilitar antes de aplicar 004.
PASSWORD_RECOVERY_HMAC_KEY_HEX=
PASSWORD_RECOVERY_HMAC_KEY_VERSION=v1
PASSWORD_RECOVERY_RATE_HMAC_KEY_HEX=
PASSWORD_RECOVERY_DIGITS=6
PASSWORD_RECOVERY_TTL_SECONDS=600
PASSWORD_RECOVERY_MAX_ATTEMPTS=5
PASSWORD_RECOVERY_COOLDOWN_SECONDS=60
PASSWORD_RECOVERY_WINDOW_SECONDS=3600
PASSWORD_RECOVERY_EMAIL_LIMIT=5
PASSWORD_RECOVERY_IP_LIMIT=20

# Chatbot IA: deshabilitado por defecto. La clave pertenece solo al backend.
AI_ENABLED=false
# Proveedores admitidos: openai o gemini.
AI_PROVIDER=openai
AI_API_KEY=
# Usar exclusivamente cuando AI_PROVIDER=gemini; no copiarla al frontend.
GEMINI_API_KEY=
# Configurar explícitamente un modelo disponible para la cuenta del proveedor.
AI_MODEL=
AI_MAX_OUTPUT_TOKENS=300
AI_TIMEOUT_MS=10000
AI_RATE_LIMIT_MAX_REQUESTS=10
AI_RATE_LIMIT_WINDOW_SECONDS=60
