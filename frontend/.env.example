# Dirección pública de la API, incluido /api, sin credenciales.
# Abrir Vite en http://127.0.0.1:5173 y autorizar ese origen exacto en el backend.
VITE_API_URL=http://127.0.0.1:4000/api

# false: registro público sin /auth/me (todavía no implementado en Naomi).
# true: habilitar recuperación de sesión solo cuando exista ese contrato en la API.
VITE_ENABLE_API_SESSION=false

# Vista independiente con estudiante ficticio. Solo funciona con npm run dev.
# true: revisión local de registro/verificación y vistas privadas, sin /auth/me.
# false: registro/login y recuperación de sesión mediante la API.
VITE_ENABLE_FRONTEND_PREVIEW=false

# Con la vista de desarrollo activada, /?view=admin abre la cuenta administradora
# de prueba separada del login real. No existe en la compilación de producción.
# /?view=register abre el registro local; verification=expired o service-error
# añade el fixture de expiración o error. /?view=api selecciona el acceso API.
# /?view=api-register abre el registro HTTP conservando los recorridos locales.
# CORS_ORIGIN del backend debe incluir exactamente el host y puerto de Vite.
