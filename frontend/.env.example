# Dirección pública de la API, incluido /api, sin credenciales.
# Abrir Vite en http://127.0.0.1:5173 (origen permitido por el backend).
VITE_API_URL=http://127.0.0.1:3000/api

# Vista independiente con estudiante ficticio. Solo funciona con npm run dev.
# true: datos simulados sin llamadas de sesión; false: registro/login reales.
VITE_ENABLE_FRONTEND_PREVIEW=false
